# Copy to .env (`make setup` does this) and fill in real values. .env is git-ignored; never commit it.

# --- Database (used by docker-compose.yml and the app) ---
POSTGRES_USER=casper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=casper
# Connection string the app uses. Keep it in sync with the three values above.
DATABASE_URL=postgresql://casper:change-me@localhost:5432/casper

# --- Models ---
# Where Ollama is listening. Localhost when running on the host; a container needs a
# different address (see Day 11).
OLLAMA_BASE_URL=http://localhost:11434
# Claude API key (week 5). Leave empty until then.
ANTHROPIC_API_KEY=

# --- Casper ---
# Absolute path to your Obsidian vault. Never point this at risr/ work documents.
CASPER_VAULT_PATH=
# dev | test | prod
CASPER_ENV=dev
